<idea-plugin>
    <id>com.pumpkin.intellij.pumpkin-plugin</id>
    <name>Pumpkin Support</name>
    <vendor>Pumpkin</vendor>
    <description><![CDATA[
        Adds IDE support for <b>Pumpkin Processes</b> – <code>@pumpkin</code>-tagged Cucumber/Gherkin
        Scenarios that can be invoked with the <code>* Process: ...</code> step syntax.<br/><br/>
        Features:
        <ul>
            <li>Navigation: Option/Alt-click on a Process invocation jumps to the definition</li>
            <li>Completion: suggests matching Process names after <code>Process: </code></li>
            <li>Highlighting: distinguishes the <code>Process:</code> keyword and variable values</li>
            <li>Inspection: reports missing required parameters with a quick fix</li>
            <li>Configurable process directories and highlight colors</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Java PSI APIs (PsiClass, PsiEnumConstant, ClassInheritorsSearch, etc.) -->
    <depends>com.intellij.modules.java</depends>
    <!--
      The "Gherkin" plugin (marketplace ID 9164, XML ID "gherkin") provides all
      Gherkin PSI classes: GherkinFile, GherkinScenario, GherkinStep, GherkinTable, etc.
      Users must install the "Gherkin" or "Cucumber for Java" plugin alongside this plugin.
    -->
    <depends>gherkin</depends>
    <!-- Bundled JSON-language module, used for syntax highlighting in the
         "Add API Endpoint" body-template editor. Ships with every IC/IU install. -->
    <depends>com.intellij.modules.json</depends>
    <!--
      "Database Tools and SQL" - bundled with IntelliJ Ultimate and DataGrip, NOT Community.
      Optional: everything that touches its API lives in pumpkin-database.xml, which the platform
      only loads when this plugin is actually present - see WorkflowDataSourceBridge's doc for why
      (referencing com.intellij.database.* classes from always-loaded code would break Community).
    -->
    <depends optional="true" config-file="pumpkin-database.xml">com.intellij.database</depends>

    <extensionPoints>
        <!-- Seam for the optional Database-plugin integration - see WorkflowDataSourceBridge. -->
        <extensionPoint name="workflowDataSourceBridge"
                         interface="com.pumpkin.intellij.workflow.WorkflowDataSourceBridge"
                         dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ── Services ── -->
        <projectService
                serviceImplementation="com.pumpkin.intellij.settings.PumpkinSettingsState"/>
        <projectService
                serviceImplementation="com.pumpkin.intellij.repository.PumpkinProcessService"/>
        <projectService
                serviceImplementation="com.pumpkin.intellij.contextparam.PumpkinContextParameterService"/>

        <!-- ── Settings UI ── -->
        <projectConfigurable
                parentId="tools"
                id="com.pumpkin.intellij.settings.PumpkinSettingsConfigurable"
                displayName="Pumpkin"
                instance="com.pumpkin.intellij.settings.PumpkinSettingsConfigurable"/>

        <!-- ── Annotator ── -->
        <!-- order="after ...GherkinAnnotator": must run after Gherkin's own bundled annotator
             (org.jetbrains.plugins.cucumber.psi.annotator.GherkinAnnotator, registered in
             gherkin.jar), which colors any part of a step resolved as a GherkinStepParameter -
             i.e. text matching a capture group in the underlying step-definition regex (e.g. the
             "| ContextName" suffix, once that regex has a group for it). A plain order="last"
             wasn't a strong enough guarantee against another equally-"last" entry - naming
             Gherkin's own annotator explicitly is deterministic. -->
        <annotator
                language="Gherkin"
                order="after org.jetbrains.plugins.cucumber.psi.annotator.GherkinAnnotator"
                implementationClass="com.pumpkin.intellij.highlighting.PumpkinProcessAnnotator"/>

        <!-- ── Highlights the table/column actually under test inside a DB-step header cell's
             join(...)/rejoin(...) spec - see DbStepReferenceAnnotator's class doc ── -->
        <annotator
                language="Gherkin"
                order="after org.jetbrains.plugins.cucumber.psi.annotator.GherkinAnnotator"
                implementationClass="com.pumpkin.intellij.dbstep.DbStepReferenceAnnotator"/>

        <!-- ── Warns on a generated "auth:" step whose API's proxy overrides
             getApiAuthenticationProvider() itself, bypassing step-selected providers entirely -
             see AuthStepAnnotator's class doc ── -->
        <annotator
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.api.AuthStepAnnotator"/>

        <!-- ── "Sets Parameters: ..." inlay hint above Process: steps ── -->
        <codeInsight.inlayProvider
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.highlighting.PumpkinContextParametersInlayHintsProvider"/>

        <!-- ── Completion ── -->
        <completion.contributor
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.completion.PumpkinProcessCompletionContributor"
                order="first"/>
        <completion.contributor
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.completion.PumpkinTagCompletionContributor"/>
        <!-- ── "%contextParameter%" autocomplete: typing % forces the completion popup open
             (ContextParameterTypedHandler) and suggests every context-parameter name already
             established before that point in the scenario (ContextParameterCompletionContributor,
             backed by PumpkinContextParameterService) - see PumpkinContextParameterService's class
             doc for the four sources it derives these from. ── -->
        <completion.contributor
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.contextparam.ContextParameterCompletionContributor"/>
        <typedHandler implementationClass="com.pumpkin.intellij.contextparam.ContextParameterTypedHandler"/>
        <!-- ── Schema-driven autocomplete for "these values are present in <table>" DB steps -
             table names, column names, and join(...)/saveToContext(...) template chaining, backed
             by the same WorkflowDataSourceBridge seam the Workflow Assertion feature uses. See
             DbStepCompletionContributor's class doc. ── -->
        <completion.contributor
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.dbstep.DbStepCompletionContributor"/>
        <!-- ── Autocomplete for "outgoing payload is compliant with template <path>" steps
             (generated by dwf:) - suggests existing template files under the current feature
             file's own XX folder, and builds a required-fields table below on selection. See
             OutgoingPayloadTemplateCompletionContributor's class doc. ── -->
        <completion.contributor
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.workflow.processed.OutgoingPayloadTemplateCompletionContributor"/>
        <!-- ── "op:" shortcut: typing this (optionally after a step keyword) opens a filterable
             popup of every outgoing-payload template file under the current feature file's own XX
             folder - selecting one generates the whole "outgoing payload is compliant with
             template <path>" step plus its required-fields table. See
             OutgoingPayloadTriggerHandler's class doc. ── -->
        <typedHandler implementationClass="com.pumpkin.intellij.workflow.processed.OutgoingPayloadTriggerHandler"/>
        <!-- ── Pressing Enter after a DB "present in <table>" step with no table below it yet
             inserts a single-column header+blank-row skeleton - see DbStepEnterHandler's class doc,
             mirrors StoreContextValuesEnterHandler's own shape for a different step. ── -->
        <enterHandlerDelegate implementation="com.pumpkin.intellij.dbstep.DbStepEnterHandler"/>
        <!-- ── "db:" shortcut: typing this (optionally after a step keyword) opens a filterable
             popup of every table in the configured datasource's schema - selecting one generates
             the whole "these values are present in <table>" step plus its table skeleton, caret in
             the first header cell. See DbStepTriggerHandler's class doc. ── -->
        <typedHandler implementationClass="com.pumpkin.intellij.dbstep.DbStepTriggerHandler"/>
        <!-- ── "wf:123" shortcut: pressing Enter after typing this generates the workflow's
             default-scenario assertion steps directly into the document, similar in spirit to
             Java's "psvm" live template - see WorkflowShortcutEnterHandler's class doc ── -->
        <enterHandlerDelegate implementation="com.pumpkin.intellij.workflow.WorkflowShortcutEnterHandler"/>
        <typedHandler implementationClass="com.pumpkin.intellij.workflow.WorkflowShortcutTypedHandler"/>
        <!-- ── "dwf:<datasource>:<true|false>:<workflow instance id>" shortcut: two chained
             filterable popups (datasource, then whether to also generate outgoing-payload steps)
             followed by a hand-typed numeric id - pressing Enter then generates assertion steps
             from an ACTUALLY-PROCESSED workflow instance (not just its template), recursively
             expanding any subworkflow that was actually entered - see
             ProcessedWorkflowAssertionGenerator's class doc ── -->
        <enterHandlerDelegate implementation="com.pumpkin.intellij.workflow.processed.ProcessedWorkflowEnterHandler"/>
        <typedHandler implementationClass="com.pumpkin.intellij.workflow.processed.ProcessedWorkflowTriggerHandler"/>

        <!-- ── Pressing Enter after "I store these values in context"/"I store this value into
             context" inserts a fieldName/value data table below it, cursor in the blank row's
             first column - see StoreContextValuesEnterHandler's class doc ── -->
        <enterHandlerDelegate implementation="com.pumpkin.intellij.context.StoreContextValuesEnterHandler"/>

        <!-- ── "api:" shortcut: typing this opens a filterable popup of every ApiNotation, then
             (after picking one) a second filterable popup of that proxy's endpoints - selecting
             one generates the full "I send a/an ... to API ..." step, with a parameter table if
             needed. See ApiStepTriggerHandler's class doc. ── -->
        <typedHandler implementationClass="com.pumpkin.intellij.api.ApiStepTriggerHandler"/>

        <!-- ── "auth:" shortcut: typing this opens a filterable popup of every ApiNotation, then
             (after picking one) a second filterable popup of every known authentication provider -
             selecting one generates the "I use authentication <name> for <API> in this scenario"
             step. See AuthStepTriggerHandler's class doc. ── -->
        <typedHandler implementationClass="com.pumpkin.intellij.api.AuthStepTriggerHandler"/>

        <!-- ── Go-to-Declaration handler (navigation, runs before Cucumber's handler) ── -->
        <gotoDeclarationHandler
                implementation="com.pumpkin.intellij.navigation.PumpkinGotoDeclarationHandler"
                order="first"/>
        <!-- ── Reverse: Ctrl/Cmd+click a @pumpkin Scenario's header to jump to its usages ── -->
        <gotoDeclarationHandler
                implementation="com.pumpkin.intellij.navigation.PumpkinProcessUsagesGotoDeclarationHandler"
                order="first"/>

        <!-- ── PSI Reference contributor (navigation) ── -->
        <psi.referenceContributor
                language="Gherkin"
                implementation="com.pumpkin.intellij.navigation.PumpkinProcessReferenceContributor"/>

        <!-- ── Gutter icon on a @pumpkin Scenario's @pumpkin tag: click to see all usages,
             with a custom popup showing "file:line" for each (see class doc for why this is a
             gutter icon rather than the Ctrl/Cmd+click popup above) ── -->
        <codeInsight.lineMarkerProvider
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.navigation.PumpkinProcessUsagesLineMarkerProvider"/>

        <!-- ── API endpoint inlay hints (method + path above matching steps) ──
             Clicking the API tag navigates to the endpoint enum constant
             (see ApiInlayHintsProvider), not on the step text. ── -->
        <codeInsight.inlayProvider
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.api.ApiInlayHintsProvider"/>

        <!-- ── Inspection ── -->
        <localInspection
                language="Gherkin"
                shortName="PumpkinMissingRequiredParameter"
                displayName="Missing Pumpkin Process required parameter"
                groupName="Pumpkin"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.pumpkin.intellij.inspection.PumpkinProcessInspection"/>

        <localInspection
                language="Gherkin"
                shortName="PumpkinProcessRecursion"
                displayName="Pumpkin Process recursion"
                groupName="Pumpkin"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.pumpkin.intellij.inspection.PumpkinProcessRecursionInspection"/>

        <localInspection
                language="Gherkin"
                shortName="PumpkinDuplicateProcessContext"
                displayName="Duplicate Pumpkin Process name/context"
                groupName="Pumpkin"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.pumpkin.intellij.inspection.DuplicateProcessContextInspection"/>

        <!-- ── Gherkin section folding (# Section: … / # End) ── -->
        <lang.foldingBuilder
                language="Gherkin"
                implementationClass="com.pumpkin.intellij.section.GherkinSectionFoldingBuilder"/>

        <!-- ── Color settings page ── -->
        <colorSettingsPage
                implementation="com.pumpkin.intellij.highlighting.PumpkinColorSettingsPage"/>

        <!-- ── Default color scheme overrides ── -->
        <additionalTextAttributes scheme="Default"  file="colorSchemes/PumpkinDefault.xml"/>
        <additionalTextAttributes scheme="Darcula"  file="colorSchemes/PumpkinDarcula.xml"/>
        <additionalTextAttributes scheme="High contrast" file="colorSchemes/PumpkinDarcula.xml"/>

        <!-- ── Pumpkin floating toolbar button (Add API Endpoint, etc.) ── -->
        <editorFloatingToolbarProvider implementation="com.pumpkin.intellij.actions.PumpkinFloatingToolbarProvider"/>

    </extensions>

    <actions>
        <!-- The root group here is purely structural: ActionToolbarImpl renders a floating
             toolbar's root group's CHILDREN as buttons, never the root group itself, so the
             actual visible pumpkin button is the nested popup group below. -->
        <group id="Pumpkin.FloatingToolbar">
            <group id="Pumpkin.Menu" icon="com.pumpkin.intellij.icons.PumpkinIcons.PUMPKIN"
                   text="Pumpkin" popup="true">
                <group id="Pumpkin.APIs" text="APIs" popup="true">
                    <action id="Pumpkin.AddApiEndpoint"
                            class="com.pumpkin.intellij.actions.AddApiEndpointAction"
                            text="Add API Endpoint..."
                            description="Generate a new endpoint on an existing API proxy"/>
                    <action id="Pumpkin.AddApiProxy"
                            class="com.pumpkin.intellij.proxy.AddApiProxyAction"
                            text="Add API Proxy..."
                            description="Generate a new API proxy class, ApiNotation constant, and (if needed) authentication provider"/>
                    <action id="Pumpkin.AddPostProcessor"
                            class="com.pumpkin.intellij.api.postprocessor.AddPostProcessorAction"
                            text="Add PostProcessor..."
                            description="Generate a PostProcessor case (or a whole new PostProcessor) for an API endpoint"/>
                </group>
                <group id="Pumpkin.Generator" text="Generator" popup="true">
                    <action id="Pumpkin.GenerateWorkflowAssertion"
                            class="com.pumpkin.intellij.workflow.GenerateWorkflowAssertionAction"
                            text="Workflow Assertion..."
                            description="Generate workflow-assertion Gherkin steps from a Workflow ID"/>
                </group>
            </group>
        </group>

        <!-- ── "Extract Process...": select a run of Gherkin steps and extract them into a new
             Process feature file under a sibling "_processes" folder. Added to the standard
             "RefactoringMenu" group so it shows up in both the main Refactor menu and the
             editor's right-click Refactor submenu, and shares Extract Method's own keyboard
             shortcut via use-shortcut-of (whatever keymap/customization is active) - see
             ExtractProcessAction's class doc. ── -->
        <action id="Pumpkin.ExtractProcess"
                class="com.pumpkin.intellij.refactor.ExtractProcessAction"
                text="Extract Process..."
                description="Extract the selected Gherkin steps into a new, reusable Pumpkin Process"
                use-shortcut-of="ExtractMethod">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
